{
  // Rig only: no input device, output device, monitor, or render settings.
  // Focused None Star full-rig NAM comparison rig: no FX-loop reverb.
  name: "none-star-clean-edge-dry-cab",

  chain: {
    cable_capacitance_pf: 470,
  },

  pre_amp: [],

  fx_loop: [],

  amp: {
    model: "none-star",
    bypassed: false,
    controls: {
      volume: 0.62,
      bass: 0.56,
      // Temporary mid control until shared amp controls expose `mid`.
      cut: 0.58,
      treble: 0.60,
      drive: 0.28,
      presence: 0.48,
      sag: 0.42,
    },
  },

  cab: {
    ir: "lab/references/tone3000-irs/mesa.wav",
    bypassed: false,
  },
}
